[init]
	defaultBranch = trunk

[gpg]
	format = ssh

[column]
	ui = auto

[branch]
	sort = -committerdate

[tag]
	sort = version:refname

[diff]
	algorithm = histogram
	colorMoved = plain
	mnemonicPrefix = true
	renames = true

[commit]
	gpgsign = true

# include aliases
[include]
	path = alias

# include identity stuff
[include]
	path = identity
