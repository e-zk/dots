# ~/lib/x/rc
# xsession rc file
. ~/.profile

export LANG=en_AU.UTF-8
export MOZ_USE_XINPUT2=1
export MOZ_ACCELERATED=1
export MOZ_WEBRENDER=1

eval $(ssh-agent -s)

fc-cache -f &
xrdb -merge ~/lib/x/res &
urxvtd -q -o -f &
xsetroot -solid gray &
sctd &
#xrandr
#xrandr --output HDMI-1 --above eDP-1 & # wait for monitors to init
~/bin/status | (sleep 1; ~/bin/bar) 2> /dev/null &
cwm -c ~/lib/x/cwmrc
